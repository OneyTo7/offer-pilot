# OfferPilot（面壁）— Environment Configuration
# Copy this file to .env and fill in your values.
# docker compose will automatically pick up variables from .env

# --- Database ---
MYSQL_ROOT_PASSWORD=rootpass
POSTGRES_PASSWORD=pgpass

# --- AI Services ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
BAILIAN_API_KEY=your-bailian-api-key-here

# --- File Storage ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Auth ---
# JWT 密钥（openssl rand -hex 32 生成）
SA_TOKEN_JWT_SECRET=change-me-in-production
# API Key 加密密钥（AES-256-GCM，必须为 64 字符十六进制；openssl rand -hex 32 生成）
# 注意：更换此密钥会导致已加密存储的用户 API Key 无法解密，生产环境务必固定
API_KEY_ENCRYPTION_SECRET=change-me-64-hex-chars