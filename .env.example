# ============================================
# OfferPilot（面壁）环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# DeepSeek API Key（必填，AI 对话核心）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# MySQL 数据库密码
MYSQL_ROOT_PASSWORD=root

# PostgreSQL（pgvector）密码
POSTGRES_PASSWORD=postgres

# MinIO 对象存储密钥
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Sa-Token JWT 密钥（生产环境请修改为随机字符串）
SA_TOKEN_JWT_SECRET=offer-pilot-jwt-secret-key-change-in-production

# 阿里云百炼 API Key（可选，简历解析用）
BAILIAN_API_KEY=